{
  "name": "note",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/build-sw.mjs",
    "start": "node dist-api/server.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-api/server.mjs",
    "build:windows": "npx --yes --package=node@22.23.2 node node_modules/vinext/dist/cli.js build && node scripts/build-sw.mjs",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "android:sync": "cap sync android"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
